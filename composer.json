{
    "name": "pairdevs/askora-community-qa",
    "description": "A modern Question & Answer plugin for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "PairDevs",
            "homepage": "https://github.com/PairDevs/askora-community-qa"
        }
    ],
    "autoload": {
        "psr-4": {
            "ASKORA\\": "Inc/",
            "ASKORA\\Admin\\": "Admin/",
            "ASKORA\\Frontend\\": "Frontend/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
